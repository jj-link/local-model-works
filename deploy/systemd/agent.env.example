LMW_AGENT_SERVER=https://lmw.example.tailnet.ts.net:9443
LMW_AGENT_CA_SHA256=<64-hex-controller-ca-fingerprint>
LMW_AGENT_TOKEN=<one-use-enrollment-token>
LMW_AGENT_STATE_ROOT=/var/lib/local-model-works-agent
LMW_AGENT_WORKSPACE=/var/lib/local-model-works-agent/workspace
LMW_AGENT_DOCKER_SOCKET=/var/run/docker.sock
LMW_AGENT_CACHE_ROOTS=/home/operator/.cache/huggingface:/srv/models
LMW_PEER_ADDR=:9444
LMW_PEER_ADVERTISE=node.example.tailnet.ts.net:9444
