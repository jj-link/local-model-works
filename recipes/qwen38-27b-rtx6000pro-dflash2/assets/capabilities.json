{
  "schema_version": 1,
  "api": "openai-completions",
  "input": ["text", "image"],
  "max_output_tokens": 32768,
  "quantization": {
    "weights": "FP8"
  },
  "tools": {
    "supported": true,
    "parallel": true
  },
  "reasoning": {
    "supported": true,
    "can_disable": true,
    "levels": ["low", "medium", "xhigh"],
    "default": "xhigh",
    "request_format": "qwen-chat-template",
    "response_field": "reasoning_content"
  }
}
