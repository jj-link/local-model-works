{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localmodelworks.dev/schemas/catalog/v1alpha1.schema.json",
  "title": "Local Model Works recipe catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "recipes"],
  "properties": {
    "apiVersion": { "const": "localmodelworks/v1alpha1" },
    "kind": { "const": "RecipeCatalog" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])?$" },
        "description": { "type": "string", "maxLength": 4000 }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "summary", "oci"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])?$" },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-([a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*))?(\\+([a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*))?$"
          },
          "summary": { "type": "string", "maxLength": 500 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$" },
            "uniqueItems": true
          },
          "oci": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "digest"],
            "properties": {
              "reference": { "type": "string", "maxLength": 512 },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
