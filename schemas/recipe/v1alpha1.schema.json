{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localmodelworks.dev/schemas/recipe/v1alpha1.schema.json",
  "title": "Local Model Works recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "compatibility", "artifacts", "workloads"],
  "properties": {
    "apiVersion": { "const": "localmodelworks/v1alpha1" },
    "kind": { "const": "Recipe" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "license", "source"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9./-]{1,100}[A-Za-z0-9])?$" },
        "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-([a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*))?(\\+([a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*))?$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "model": { "type": "string", "maxLength": 256 },
        "engine": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$" },
        "license": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*( (AND|OR) [A-Za-z0-9][A-Za-z0-9.-]*)*( WITH [A-Za-z0-9][A-Za-z0-9.-]*)?$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "revision", "path"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "path": { "type": "string", "pattern": "^\\S+$", "maxLength": 512 },
            "procedure": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "description": "Stable identifier of a separately documented upstream launch procedure." }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCount"],
      "properties": {
        "nodeCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "accelerator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vendor": { "type": "string", "minLength": 1, "maxLength": 32 },
            "architectures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "count": { "type": "integer", "minimum": 0 },
            "minMemoryBytes": { "type": "integer", "minimum": 0 },
            "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "fabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": { "type": "string", "enum": ["roce", "tcp"] },
            "minBandwidthGbps": { "type": "integer", "minimum": 0 },
            "sharedGIDIndex": { "type": "boolean" }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/artifact" },
      "minContains": 0
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" },
      "maxItems": 512
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/workload" }
    },
    "prepare": { "$ref": "#/$defs/extension" },
    "assets": {
      "type": "array",
      "description": "Package asset files, relative to the recipe root; mounted read-only at /lmw/assets.",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
      "uniqueItems": true,
      "maxItems": 256
    },
    "verify": { "$ref": "#/$defs/extension" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workloads": { "contains": { "required": ["upstream"] } } },
        "required": ["workloads"]
      },
      "then": {
        "properties": {
          "artifacts": { "maxItems": 0 },
          "prepare": false,
          "verify": false,
          "metadata": {
            "properties": {
              "source": {
                "properties": {
                  "path": { "anyOf": [{ "const": "." }, { "$ref": "#/$defs/upstreamPath" }] }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "templateString": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^(\\$\\{(?:node\\.(?:id|rank|address)|fabric\\.(?:address|node_address|interface|rdma_device|gid_index)|cluster\\.node\\.(?:0|[1-9][0-9]*)\\.(?:id|address|fabric\\.(?:node_addr|interface|rdma_device|gid_index))|artifact\\.[a-z0-9][a-z0-9_]*\\.path|setting\\.[a-z0-9][a-z0-9_]*)\\}|[^${])*$"
    },
    "upstreamPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    },
    "upstreamString": {
      "allOf": [
        { "$ref": "#/$defs/templateString" },
        { "not": { "pattern": "[\\x00-\\x1f\\x7f-\\x9f]|\\$\\{artifact\\.|(^|[/\\\\=\\s])\\.\\.([/\\\\\\s]|$)" } }
      ]
    },
    "upstreamArgv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "prefixItems": [{ "allOf": [{ "$ref": "#/$defs/upstreamString" }, { "pattern": "\\S" }] }],
      "items": { "$ref": "#/$defs/upstreamString" }
    },
    "upstreamContainers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "allOf": [{ "$ref": "#/$defs/upstreamString" }, { "minLength": 1, "pattern": "^(?:[A-Za-z0-9]|\\$\\{[^}]+\\})(?:[A-Za-z0-9_.-]|\\$\\{[^}]+\\})*$" }] }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop", "containers"],
      "properties": {
        "configuration": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/sourceConfigurationFile" } },
        "install": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/upstreamArgv" } },
        "installByRank": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" },
          "additionalProperties": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/upstreamArgv" } }
        },
        "start": { "$ref": "#/$defs/upstreamArgv" },
        "stop": { "$ref": "#/$defs/upstreamArgv" },
        "containers": { "$ref": "#/$defs/upstreamContainers" },
        "coordinatorRank": { "type": "integer", "const": 0, "description": "The authored coordinator runs on the API head (rank zero); other ranks independently observe it." },
        "containersByRank": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" },
          "additionalProperties": { "$ref": "#/$defs/upstreamContainers" }
        },
        "auxiliaryContainers": { "$ref": "#/$defs/upstreamContainers" },
        "envFile": { "$ref": "#/$defs/upstreamPath" },
        "envTemplate": { "$ref": "#/$defs/upstreamPath" },
        "envFormat": { "type": "string", "enum": ["shell", "literal"] },
        "logFile": { "$ref": "#/$defs/upstreamPath" }
      },
      "dependentRequired": { "envTemplate": ["envFile"], "envFile": ["envFormat"], "envFormat": ["envFile"] }
    },
    "sourceConfigurationFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "edits"],
      "properties": {
        "path": { "allOf": [{ "$ref": "#/$defs/upstreamPath" }, { "maxLength": 1024 }] },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "edits": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/sourceConfigurationEdit" } }
      }
    },
    "sourceConfigurationEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "format"],
      "oneOf": [{ "required": ["parameter"] }, { "required": ["template"] }, { "required": ["variable"] }, { "required": ["command"] }],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "end": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "parameter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,62}$" },
        "template": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 256 },
        "command": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 256 },
        "indirect": { "type": "boolean" },
        "prefix": { "type": "string", "maxLength": 1048576 },
        "suffix": { "type": "string", "maxLength": 1048576 },
        "format": { "type": "string", "enum": ["shell", "shell-word", "shell-reparse", "shell-heredoc", "shell-quoted-heredoc", "shell-double-quoted", "shell-compose", "json-compose", "flag", "flag-compose", "argv", "argv-heredoc", "argv-quoted-heredoc"] },
        "flag": { "type": "string", "pattern": "^--?[A-Za-z0-9][A-Za-z0-9_-]*$" }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "enum": ["flag", "flag-compose"] } } },
          "then": { "required": ["flag"] },
          "else": { "properties": { "flag": false } }
        },
        {
          "if": { "properties": { "format": { "const": "shell-word" } } },
          "then": { "anyOf": [{ "required": ["variable"] }, { "required": ["command"] }] },
          "else": { "properties": { "variable": false, "command": false, "prefix": false, "suffix": false, "indirect": false } }
        }
        ,{
          "if": { "required": ["command"] },
          "then": { "properties": { "prefix": false, "suffix": false, "indirect": false } }
        }
      ]
    },
    "variantSource": {

      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity"],
      "properties": {
        "type": { "type": "string", "enum": ["huggingface", "oci", "file"] },
        "identity": {
          "type": "string",
          "pattern": "^(hf://[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+|[a-z0-9][a-z0-9.-]*(:[0-9]+)?/[a-zA-Z0-9._/-]+)$",
          "maxLength": 512
        },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "huggingface" } } },
          "then": { "required": ["revision"] }
        },
        {
          "if": { "properties": { "type": { "const": "file" } } },
          "then": { "required": ["digest"] }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "mount"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,62}$" },
        "kind": { "type": "string", "enum": ["model", "dataset", "adapter", "checkpoint", "file"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "source": { "$ref": "#/$defs/variantSource" },
        "defaultVariant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,62}$" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,62}$" },
              "label": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 512 },
              "source": { "$ref": "#/$defs/variantSource" }
            }
          }
        },
        "mount": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
        "validation": { "type": "string", "enum": ["snapshot", "directory", "file"] }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["source"] },
            { "required": ["variants"] }
          ]
        },
        {
          "if": { "properties": { "kind": { "enum": ["model", "dataset", "adapter", "checkpoint"] } } },
          "then": { "properties": { "validation": { "enum": ["snapshot", "directory"] } } }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,62}$" },
        "type": { "type": "string", "enum": ["int", "float", "bool", "string", "enum"] },
        "default": {},
        "description": { "type": "string", "maxLength": 1000 },
        "label": { "type": "string", "maxLength": 256 },
        "group": { "type": "string", "maxLength": 256 },
        "format": { "type": "string", "enum": ["", "argv"] },
        "optional": { "type": "boolean", "description": "Omission preserves the upstream default instead of requiring an override." },
        "forbiddenArgs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "maxLength": 128, "pattern": "^--?[A-Za-z0-9][A-Za-z0-9_-]*$" } },
        "argvPolicy": { "type": "string", "enum": ["", "docker"] },
        "forbiddenEnv": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "sensitive": { "type": "boolean", "description": "Redact this parameter's value from selected AI assistance log excerpts." },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64, "items": {} }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["enum"] }
        }
      ]
    },
    "httpGet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "port"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "body": { "type": "string", "maxLength": 65536 }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": { "$ref": "#/$defs/httpGet" },
        "exec": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 10 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600, "default": 30 },
        "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 30, "default": 5 }
      },
      "oneOf": [
        { "required": ["httpGet"] },
        { "required": ["exec"] }
      ]
    },
    "verifyProbe": {
      "description": "Probe plus the verify-only expectation block. Kept separate from probe because probe's additionalProperties:false would otherwise reject expect.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": { "$ref": "#/$defs/httpGet" },
        "exec": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 10 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600, "default": 30 },
        "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 30, "default": 5 },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
            "bodyContains": { "type": "string", "maxLength": 8192 },
            "json": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
          }
        }
      },
      "oneOf": [
        { "required": ["httpGet"] },
        { "required": ["exec"] }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "if": { "required": ["upstream"] },
      "allOf": [
        {
          "if": { "required": ["upstream"], "properties": { "upstream": { "required": ["coordinatorRank"] } } },
          "then": { "properties": { "startOrder": { "const": "parallel" } } }
        }
      ],
      "then": {
        "required": ["permissions"],
        "properties": {
          "image": false,
          "command": false,
          "args": false,
          "resources": false,
          "devices": false,
          "networkMode": false,
          "hostPreparation": false,
          "permissions": { "contains": { "const": "host.upstream-exec" } },
          "env": { "additionalProperties": { "$ref": "#/$defs/upstreamString" } },
          "ranks": { "uniqueItems": true, "items": { "maximum": 63 } },
          "readiness": { "required": ["httpGet"], "properties": { "exec": false } },
          "verify": { "required": ["httpGet"], "properties": { "exec": false } }
        }
      },
      "else": { "required": ["image", "command", "args", "resources"] },
      "properties": {
        "upstream": { "$ref": "#/$defs/upstream" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "description": "Capability predicate; first matching variant wins. Empty matches anything.",
          "properties": {
            "accelerator": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "architectures": { "type": "array", "items": { "type": "string" } },
                "vendor": { "type": "string" },
                "features": { "type": "array", "items": { "type": "string" } }
              }
            },
            "nodeCount": { "type": "integer", "minimum": 1 }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest"],
          "properties": {
            "reference": { "type": "string", "maxLength": 512 },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "maxItems": 32 },
        "args": { "type": "array", "items": { "$ref": "#/$defs/templateString" }, "maxItems": 256 },
        "env": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/templateString" },
          "maxProperties": 256,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "ports": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["container"],
            "properties": {
              "container": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "host": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": { "type": "string", "enum": ["tcp", "udp"], "default": "tcp" }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pids"],
          "properties": {
            "shmBytes": { "type": "integer", "minimum": 67108864 },
            "tmpfsBytes": { "type": "integer", "minimum": 67108864, "maximum": 34359738368 },
            "pids": { "type": "integer", "minimum": 64 }
          }
        },
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accelerator": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "all": { "type": "boolean", "default": false },
                "indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
              }
            },
            "rdma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "all": { "type": "boolean", "default": false },
                "devices": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "networkMode": { "type": "string", "enum": ["bridge", "host", "none"], "default": "none" },
        "readiness": { "$ref": "#/$defs/probe" },
        "verify": { "$ref": "#/$defs/verifyProbe" },
        "ranks": {
          "type": "array",
          "description": "Fabric ranks this variant covers on the first node; remaining ranks implied for multi-node recipes.",
          "items": { "type": "integer", "minimum": 0 },
          "maxItems": 8
        },
        "startOrder": {
          "type": "string",
          "enum": ["parallel", "workers-first"],
          "default": "parallel",
          "description": "workers-first holds rank 0 until every worker container has started"
        },
        "hostPreparation": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "requireSwap": { "type": "boolean", "default": false },
            "swappiness": { "type": "integer", "minimum": 0, "maximum": 200 },
            "dropPageCache": { "type": "boolean", "default": false }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["network.host", "devices.rdma", "memory.shm-large", "rootfs.write", "host.memory-tuning", "host.upstream-exec"]
          },
          "uniqueItems": true
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "description": "Strictly sandboxed prepare/verify helper container.",
      "required": ["image", "command", "args", "outputSchema"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest"],
          "properties": {
            "reference": { "type": "string", "maxLength": 512 },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "maxItems": 32 },
        "args": { "type": "array", "items": { "$ref": "#/$defs/templateString" }, "maxItems": 64 },
        "env": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/templateString" },
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "network": { "type": "string", "enum": ["none", "egress"], "default": "none" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200, "default": 900 },
        "outputLimitBytes": { "type": "integer", "minimum": 4096, "maximum": 10485760, "default": 1048576 },
        "outputSchema": {
          "type": "object",
          "required": ["$schema", "type", "properties", "required"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
